<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvMapNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_circle_white_solid"
        android:contentDescription="Back"
        android:elevation="8dp"
        android:padding="11dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/color_text_primary" />

    <ImageView
        android:id="@+id/btnRecenter"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_circle_white_solid"
        android:contentDescription="Recenter map"
        android:elevation="8dp"
        android:padding="11dp"
        android:src="@drawable/ic_location_pin"
        app:tint="@color/color_primary" />

    <TextView
        android:id="@+id/btnRetryRoute"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="106dp"
        android:background="@drawable/bg_status_cancelled"
        android:elevation="8dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Retry route"
        android:textColor="#C62828"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvTrackPickupLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="20dp"
        android:background="@drawable/bg_circle_white_solid"
        android:elevation="8dp"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:text=""
        android:textColor="@color/color_text_primary"
        android:textStyle="bold" />

    <!-- Route callbacks still update these values; they are displayed on the dashboard. -->
    <TextView android:id="@+id/tvArrivalTime" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView android:id="@+id/tvTrackDistance" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
</FrameLayout>
