<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Section (Green Background) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/color_primary"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="56dp"
            android:paddingEnd="24dp"
            android:paddingBottom="48dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome back"
                android:textColor="@color/color_surface"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sign in to continue"
                android:textColor="@color/color_surface"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- White Card Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/color_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="24dp"
                android:paddingBottom="28dp">

                <!-- Email/Phone Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email/Phone"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/color_border"
                    app:boxBackgroundColor="@color/color_background"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="@color/color_text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmailPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="example@gmail.com"
                        android:inputType="textEmailAddress"
                        android:textSize="14sp"
                        android:textColor="@color/color_text_primary"
                        android:textColorHint="@color/color_text_muted" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Password"
                    android:textColor="@color/color_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxStrokeColor="@color/color_border"
                    app:boxBackgroundColor="@color/color_background"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/color_text_muted"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/color_text_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:textSize="14sp"
                        android:textColor="@color/color_text_primary"
                        android:textColorHint="@color/color_text_muted" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Remember Me + Forgot Password Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkboxRememberMe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="Remember me"
                        android:textSize="13sp"
                        android:textColor="@color/color_text_body"
                        app:buttonTint="@color/color_primary" />

                    <TextView
                        android:id="@+id/tvForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="Forgot password?"
                        android:textColor="@color/color_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Login Button -->
                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:text="Login"
                    android:textColor="@color/color_surface"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/color_primary"
                    app:cornerRadius="28dp" />

                <!-- Or continue with -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="Or continue with"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="13sp" />

                <!-- Google + Apple Buttons Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <!-- Google Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoogle"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Google"
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:icon="@drawable/ic_google"
                        app:iconTint="@null"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:cornerRadius="25dp"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp"
                        app:backgroundTint="@color/color_surface" />

                    <!-- Apple Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnApple"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Apple"
                        android:textColor="@color/color_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:icon="@drawable/ic_apple"
                        app:iconTint="#000000"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:cornerRadius="25dp"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp"
                        app:backgroundTint="@color/color_surface" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- New to takaGo? Create Account -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New to takaGo? "
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCreateAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Account"
                android:textColor="@color/color_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
