<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_surface"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <FrameLayout
        android:layout_width="180dp"
        android:layout_height="180dp">

        <View
            android:id="@+id/pulseRingOuter"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_green_light" />

        <View
            android:id="@+id/pulseRingInner"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_green_light" />

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_green_solid"
            android:padding="22dp"
            android:src="@drawable/ic_truck_outline"
            app:tint="@color/color_surface" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvFindingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:text="Finding the nearest driver..."
        android:textColor="@color/color_text_primary"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFindingSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Matching you with a driver in your ward. This usually takes a moment."
        android:textColor="@color/color_text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvCancelSearch"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="36dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Cancel and go back"
        android:textColor="#C62828"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
