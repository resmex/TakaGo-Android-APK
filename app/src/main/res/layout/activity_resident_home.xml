<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F7">

    <ScrollView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="90dp">

            <!-- GREEN HEADER -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/bg_header"
                android:paddingStart="36dp"
                android:paddingTop="58dp"
                android:paddingEnd="36dp">


                <LinearLayout
                    android:id="@+id/layoutUserInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivUserAvatar"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:src="@drawable/ic_person_placeholder"
                        app:civ_border_color="@color/color_surface"
                        app:civ_border_width="2dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Welcome"
                            android:textColor="#E6FFFFFF"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/color_surface"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvUserWard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Service ward"
                            android:textColor="#D8FFFFFF"
                            android:maxLines="2"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btnNotification"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignTop="@id/layoutUserInfo">

                    <ImageView
                        android:id="@+id/ivNotification"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_circle_white_alpha"
                        android:padding="11dp"
                        android:src="@drawable/ic_notifications"
                        app:tint="@color/color_primary" />

                    <TextView
                        android:id="@+id/tvNotificationBadge"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_circle_red"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/color_surface"
                        android:textSize="9sp"
                        android:visibility="gone" />
                </FrameLayout>
            </RelativeLayout>

            <!-- CONTENT AREA -->
            <LinearLayout
                android:id="@+id/residentContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-28dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <!-- ACTIVE PICKUP CARD -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardActivePickup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/color_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Active pickup"
                                android:textColor="@color/color_text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/layoutActiveStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_status_green"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="5dp">

                                <View
                                    android:id="@+id/dotActiveStatus"
                                    android:layout_width="6dp"
                                    android:layout_height="6dp"
                                    android:layout_marginEnd="6dp"
                                    android:background="@drawable/bg_circle_green_dark" />

                                <TextView
                                    android:id="@+id/tvActiveStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="On the way"
                                    android:textColor="#168A34"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </RelativeLayout>

                        <TextView
                            android:id="@+id/tvActivePickupAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Pickup location"
                            android:textColor="@color/color_text_primary"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:id="@+id/layoutDriverInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/ivDriverAvatar"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_person_placeholder" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvDriverName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Joshua Swai"
                                    android:textColor="@color/color_text_primary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvDriverDetails"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="T-216 KDE  •  Kirikuu"
                                    android:textColor="@color/color_text_secondary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:src="@drawable/ic_location_pin"
                                app:tint="@color/color_primary" />

                            <TextView
                                android:id="@+id/tvEta"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:text="9 min • 2.1 km away"
                                android:textColor="@color/color_text_body"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/btnViewDetails"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="View details"
                                android:textColor="@color/color_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCurrentStop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/color_text_secondary"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnTrackDriver"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginEnd="14dp"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Track driver on map"
                                android:textColor="#0B8C34"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:backgroundTint="#D8FFE2"
                                app:cornerRadius="22dp" />

                            <ImageButton
                                android:id="@+id/btnCall"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_circle_green_light"
                                android:padding="11dp"
                                android:src="@drawable/ic_phone"
                                app:tint="@color/color_primary" />

                            <ImageButton
                                android:id="@+id/btnSms"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_circle_green_light"
                                android:contentDescription="Message assigned driver"
                                android:padding="11dp"
                                android:src="@drawable/ic_message"
                                app:tint="@color/color_primary" />
                        </LinearLayout>


                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- REQUEST PICKUP CARD -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardRequestPickup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="#18B95A"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="24dp"
                        android:paddingEnd="20dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Request pickup"
                                android:textColor="@color/color_surface"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Tap to get a collection vehicle"
                                android:textColor="#E8FFFFFF"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivTruck"
                            android:layout_width="54dp"
                            android:layout_height="54dp"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_circle_white_alpha"
                            android:padding="12dp"
                            android:src="@drawable/ic_track"
                            app:tint="@color/color_primary" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="30dp"
                    android:text="Recent requests"
                    android:textColor="@color/color_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNoRecentRequests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="50dp"
                    android:paddingBottom="50dp"
                    android:text="No recent pickup requests yet."
                    android:textColor="@color/color_text_hint"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/recentRequestsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        style="@style/AppBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_gravity="bottom"
        android:background="@color/color_surface"
        app:itemIconTint="@color/bottom_nav_selector"
        app:itemTextColor="@color/bottom_nav_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
