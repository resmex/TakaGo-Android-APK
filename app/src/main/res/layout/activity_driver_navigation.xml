<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvMapNotice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="44dp"
        android:background="#EEFFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="#424242"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- COMPACT DRIVER ROUTE CARD -->
    <LinearLayout
        android:id="@+id/navigationBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_driver_navigation_card"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <!-- Main information row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Ward, street, ETA and distance -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Keep this hidden because Java may still reference it -->
                <TextView
                    android:id="@+id/tvNavPickupCode"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvNavPickupWard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="Magomeni • Lukusha Street"
                    android:textColor="@color/color_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNavEta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9 min"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" ETA  •  "
                        android:textColor="@color/color_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvNavDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="2.1 km away"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- Call resident -->
            <ImageButton
                android:id="@+id/btnCallResident"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_circle_green_light"
                android:contentDescription="Call resident"
                android:padding="12dp"
                android:src="@drawable/ic_phone"
                app:tint="@color/color_primary" />

        </LinearLayout>

        <!-- Only visible for grouped routes -->
        <LinearLayout
            android:id="@+id/rowNavStops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvNavStops"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Stop 2 of 4"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnViewStops"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="View stops"
                android:textColor="@color/color_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Hidden status retained for Java compatibility -->
        <TextView
            android:id="@+id/tvNavStatus"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <!-- Show only after GPS confirms arrival -->
        <RelativeLayout
            android:id="@+id/btnNavMarkCollected"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_admin_green_box"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvNavPrimaryAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Mark as arrived"
                android:textColor="@color/color_surface"
                android:textSize="14sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Show only during the final completion stage -->
        <RelativeLayout
            android:id="@+id/btnNavMarkCompleted"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_primary"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Submit completion"
                android:textColor="@color/color_surface"
                android:textSize="14sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Retained only for compatibility; never displayed here -->
        <TextView
            android:id="@+id/btnNavCancel"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

    </LinearLayout>

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_circle_white_solid"
        android:contentDescription="Back"
        android:elevation="8dp"
        android:padding="11dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/color_text_primary" />

    <ImageView
        android:id="@+id/btnRecenter"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="172dp"
        android:background="@drawable/bg_circle_white_solid"
        android:contentDescription="My location"
        android:elevation="8dp"
        android:padding="11dp"
        android:src="@drawable/ic_location_pin"
        android:visibility="visible"
        app:tint="@color/color_primary" />

    <TextView
        android:id="@+id/btnRetryRoute"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="52dp"
        android:background="@drawable/bg_status_cancelled"
        android:elevation="8dp"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        android:text="Retry route"
        android:textColor="#C62828"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
